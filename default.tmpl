// Storage resilience polyfill for Incognito / Private browsing modes
try {
    window.localStorage.setItem('__sipa_storage_test__', '1');
    window.localStorage.removeItem('__sipa_storage_test__');
} catch (e) {
    console.warn("Storage restricted or Incognito mode detected, enabling in-memory fallback:", e);
    const memStorage = {};
    const storageFallback = {
        getItem: function(k) { return memStorage.hasOwnProperty(k) ? memStorage[k] : null; },
        setItem: function(k, v) { memStorage[k] = String(v); },
        removeItem: function(k) { delete memStorage[k]; },
        clear: function() { for (let k in memStorage) delete memStorage[k]; },
        key: function(i) { return Object.keys(memStorage)[i] || null; },
        get length() { return Object.keys(memStorage).length; }
    };
    try { Object.defineProperty(window, 'localStorage', { value: storageFallback }); } catch(_) {}
    try { Object.defineProperty(window, 'sessionStorage', { value: storageFallback }); } catch(_) {}
}

